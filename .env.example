# ============================================================
# Daily Recap Agent — environment variables
# Copy to .env.local for local dev; set in Vercel dashboard for prod
# ============================================================

# ---- Cron authentication ----
# Random secret used to authenticate Vercel Cron requests.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ---- Vercel Sandbox ----
# Snapshot ID baked via scripts/bake-snapshot.ts
# Format: snap_XXXXXXXXXXXXXXXXXXXXXXXX
VERCEL_SANDBOX_SNAPSHOT_ID=

# In Vercel deployments: @vercel/sandbox auto-authenticates via
# VERCEL_OIDC_TOKEN (auto-injected by the platform, no config needed).
#
# For LOCAL dev: set these three so the SDK can reach the Sandbox API.
# The three values below are pulled automatically by `vercel env pull .env.local --yes`
# once the project is linked with `vercel link`.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# ---- Anthropic (Claude Code inside sandbox) ----
ANTHROPIC_API_KEY=

# ---- MCP tokens (injected into sandbox at boot) ----

# Notion — internal integration secret
# Create at https://www.notion.so/profile/integrations
NOTION_TOKEN=
NOTION_DAILY_BRIEFS_DB_ID=

# Slack — bot token from your app
# Scopes: chat:write, im:history, channels:history, groups:history, mpim:history, users:read
SLACK_BOT_TOKEN=
SLACK_USER_ID=           # your Slack user ID for DM target

# GitHub — fine-grained PAT scoped to the archive repo only
# Permissions: contents:write, metadata:read
GITHUB_TOKEN=
GITHUB_ARCHIVE_OWNER=    # e.g., "ryanxkh"
GITHUB_ARCHIVE_REPO=     # e.g., "daily-recap-archive"

# ---- Google (Gmail + Calendar) ----
# NOT REQUIRED — Claude managed connectors handle auth.
# Verified during snapshot bake; no tokens stored here.

# ---- Runtime config ----
TIMEZONE=America/Chicago
